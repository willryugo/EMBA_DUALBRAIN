# Phase 1 — 현재 필요한 환경변수
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [현재 비활성화] 단일 비밀번호 인증
# middleware.ts → middleware.ts.disabled 로 이름 바꿔 게이트 끔.
# welcome 페이지·login API·lib/auth.ts는 그대로 보존됨.
# 나중에 개인화 쿠키나 OAuth 같이 다시 고민할 때 middleware 복원 + DB_PASSWORD 설정.
# DB_PASSWORD=dualbrain17

# ─── 이벤트 로깅 (관리자 대시보드 기반) ───────────────────
# 미설정 시: /api/events가 console.log만 — Vercel Logs에서 확인.
# 설정 시: logs/events-YYYY-WW.jsonl 파일에 GitHub Contents API로 append commit.
# PAT 만들기: GitHub → Settings → Developer settings → Personal access tokens (fine-grained)
#   - Repository access: willryugo/EMBA_DUALBRAIN
#   - Permissions: Contents = Read and write
GH_TOKEN=
GH_OWNER=willryugo
GH_REPO=EMBA_DUALBRAIN
GH_BRANCH=main

