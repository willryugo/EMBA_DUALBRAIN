# Phase 1 — 현재 필요한 환경변수
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [활성화됨] 2단계 비밀번호 입장 게이트 (middleware.ts)
# 관리자(국장·부국장)와 일반 원우를 비밀번호로 구분. 둘 다 입장 가능, 관리자만 Tweaks(테마변경) 노출.
# 코드 기본값: 관리자 0604 / 원우 2580 (lib/auth.ts). 내부 공유용 캐주얼 게이트라 기본값 내장.
# 운영에서 바꾸려면 아래 env만 설정(미설정 시 기본값 사용):
# DB_ADMIN_PASSWORD=0604
# DB_MEMBER_PASSWORD=2580

# ─── 이벤트 로깅 (관리자 대시보드 기반) ───────────────────
# 미설정 시: /api/events가 console.log만 — Vercel Logs에서 확인.
# 설정 시: logs/events-YYYY-WW.jsonl 파일에 GitHub Contents API로 append commit.
# PAT 만들기: GitHub → Settings → Developer settings → Personal access tokens (fine-grained)
#   - Repository access: willryugo/EMBA_DUALBRAIN
#   - Permissions: Contents = Read and write
GH_TOKEN=
GH_OWNER=willryugo
GH_REPO=EMBA_DUALBRAIN
GH_BRANCH=main

